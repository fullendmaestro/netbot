# Target Project Configuration
GCP_PROJECT_ID=""
GCP_LOCATION=""

# Force routing to Enterprise Agent Platform instead of AI Studio
GOOGLE_GENAI_USE_VERTEXAI=true

# Explicitly target an active model tier
ANTIGRAVITY_MODEL="gemini-2.5-flash"

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,https://yourapp.com

# Logging
LOG_LEVEL=INFO

# GNS3 Integration
GNS3_SERVER_URL="http://your-gns3-server:3080"

# LibreNMS Integration
LIBRENMS_URL="http://your-librenms-instance"
LIBRENMS_TOKEN="your-x-auth-token"